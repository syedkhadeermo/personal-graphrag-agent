# Copy this file to .env, then set a unique key generated with:
# openssl rand -hex 32
GRAPH_RAG_API_KEY=
GRAPH_RAG_ALLOW_INSECURE_LOCAL=false

# Remote execution allowlists. Values must match your worker layout.
GRAPH_RAG_REMOTE_JOB_ROOT=C:\AI_Worker\jobs
GRAPH_RAG_REMOTE_ARTIFACT_ROOTS=C:\AI_Worker\results
GRAPH_RAG_REMOTE_OPENFOAM_ROOT=/mnt/c/AI_Worker/openfoam_cases
GRAPH_RAG_OPENFOAM_SOLVERS=foamRun
